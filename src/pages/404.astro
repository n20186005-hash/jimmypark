---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="找不到頁面｜JimmyPark.org" description="這個頁面不存在。" noindex={true}>
  <main class="grid min-h-screen place-items-center bg-paper px-4 py-16">
    <section class="card-soft w-full max-w-2xl rounded-[2rem] p-8 text-center sm:p-14">
      <span class="mx-auto grid size-16 place-items-center rounded-3xl bg-forest text-paper">
        <svg viewBox="0 0 32 32" class="size-8" aria-hidden="true">
          <path d="M7 24h18M10 7v14M22 7v14M10 11h12M10 17h12" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" />
          <circle cx="16" cy="7" r="2.5" fill="#f0bf48" />
        </svg>
      </span>
      <p class="mt-7 text-sm font-bold tracking-[0.2em] text-coral">404・走錯方向了</p>
      <h1 class="mt-3 text-4xl font-bold text-forest-dark">這段路不在地圖上</h1>
      <p class="mt-4 leading-7 text-ink/65">回到首頁，重新從宜蘭火車站開始散步。</p>
      <a href="/" class="mt-8 inline-flex rounded-full bg-forest px-6 py-3.5 font-bold text-white">返回首頁</a>
    </section>
  </main>
</BaseLayout>
