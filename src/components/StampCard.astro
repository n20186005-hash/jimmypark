---
import { stampSpots } from '../data/stampSpots';
---

<section id="stamp-card" class="stamp-section storybook-section scroll-mt-20 bg-[#fffdf7] px-4 py-16 sm:py-20" data-testid="stamp-card">
  <div class="container-shell">
    <div class="stamp-card">
      <div class="stamp-card-heading">
        <div>
          <p>MY YILAN WALK</p>
          <h2>宜蘭站前散步集章卡</h2>
          <span>走到景點後手動蓋章；紀錄只保存在目前瀏覽器。</span>
        </div>
        <div class="stamp-count" aria-live="polite">
          <strong><span data-stamp-count>0</span><small> / <span data-stamp-total>{stampSpots.length}</span></small></strong>
          <span>已完成景點</span>
        </div>
      </div>

      <div class="stamp-progress-track" data-stamp-progressbar role="progressbar" aria-valuemin="0" aria-valuenow="0" aria-valuemax={stampSpots.length}>
        <span data-stamp-progress></span>
      </div>

      <div class="stamp-grid" role="group" aria-label="景點集章">
        {stampSpots.map((spot, index) => (
          <button
            type="button"
            class="stamp-spot"
            data-stamp-toggle={spot.id}
            aria-pressed="false"
            aria-label={`${spot.name}集章`}
          >
            <span class="stamp-seal" aria-hidden="true">
              <small>{String(index + 1).padStart(2, '0')}</small>
              <strong>{spot.mark}</strong>
            </span>
            <span class="stamp-copy">
              <strong>{spot.name}</strong>
              <small>{spot.note}</small>
              <span data-stamp-action-label>蓋下這一站</span>
            </span>
          </button>
        ))}
      </div>

      <div class="stamp-card-footer">
        <div data-stamp-incomplete>
          <strong>還差 <span data-stamp-remaining>{stampSpots.length}</span> 站完成</strong>
          <p>不需要定位；依照現場實際到訪情況手動記錄即可。</p>
        </div>
        <div data-stamp-complete hidden>
          <strong>五個地方，五段風景。你已完成宜蘭站前繪本散步。</strong>
          <p>「五站完成紀念」風格已解鎖，可以加入今天的代表照片。</p>
        </div>
        <div class="stamp-footer-actions">
          <a data-stamp-complete hidden href="/postcard?style=collector" class="stamp-reward-link">製作完成紀念卡</a>
          <button type="button" data-stamp-reset class="stamp-reset">清除集章紀錄</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .stamp-card {
    overflow: hidden;
    border: 2px solid rgb(60 113 99 / .16);
    border-radius: 2rem;
    background:
      radial-gradient(circle at 91% 7%, rgb(244 201 94 / .24) 0 4.5rem, transparent 4.6rem),
      linear-gradient(145deg, #294f47, #1d3933);
    padding: 1.4rem;
    color: white;
    box-shadow: 0 22px 55px rgb(41 79 71 / .2);
  }
  .stamp-card-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .stamp-card-heading p {
    color: #f7d876;
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .18em;
  }
  .stamp-card-heading h2 {
    margin-top: .45rem;
    font-size: clamp(1.7rem, 4vw, 2.7rem);
    font-weight: 700;
    line-height: 1.15;
  }
  .stamp-card-heading > div > span {
    display: block;
    margin-top: .65rem;
    color: rgb(255 255 255 / .62);
    font-size: .85rem;
    line-height: 1.6;
  }
  .stamp-count {
    flex: 0 0 auto;
    min-width: 6.5rem;
    border: 1px solid rgb(255 255 255 / .16);
    border-radius: 1.3rem;
    background: rgb(255 255 255 / .08);
    padding: .8rem 1rem;
    text-align: center;
  }
  .stamp-count strong { display: block; color: #f7d876; font-size: 2rem; line-height: 1; }
  .stamp-count small { color: rgb(255 255 255 / .55); font-size: .85rem; }
  .stamp-count > span { display: block; margin-top: .4rem; color: rgb(255 255 255 / .58); font-size: .68rem; }
  .stamp-progress-track {
    height: .55rem;
    margin-top: 1.3rem;
    overflow: hidden;
    border-radius: 999px;
    background: rgb(255 255 255 / .12);
  }
  .stamp-progress-track > span {
    display: block;
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #f4c95e, #e87d62);
    transition: width .35s ease;
  }
  .stamp-grid {
    display: grid;
    gap: .7rem;
    margin-top: 1.25rem;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  .stamp-spot {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    gap: .75rem;
    border: 1px solid rgb(255 255 255 / .13);
    border-radius: 1.35rem;
    background: rgb(255 255 255 / .07);
    padding: 1rem .65rem;
    color: white;
    text-align: center;
    transition: .2s ease;
  }
  .stamp-spot:hover { border-color: rgb(247 216 118 / .5); background: rgb(255 255 255 / .11); transform: translateY(-2px); }
  .stamp-seal {
    position: relative;
    display: grid;
    width: 4.5rem;
    height: 4.5rem;
    place-items: center;
    border: 2px dashed rgb(255 255 255 / .28);
    border-radius: 45% 55% 48% 52% / 51% 43% 57% 49%;
    color: rgb(255 255 255 / .42);
    transform: rotate(-4deg);
    transition: .25s ease;
  }
  .stamp-seal small { position: absolute; top: .45rem; font-size: .52rem; letter-spacing: .08em; }
  .stamp-seal strong { font-size: 1.75rem; line-height: 1; }
  .stamp-copy strong, .stamp-copy small, .stamp-copy > span { display: block; }
  .stamp-copy strong { font-size: .8rem; line-height: 1.35; }
  .stamp-copy small { margin-top: .3rem; color: rgb(255 255 255 / .43); font-size: .62rem; line-height: 1.45; }
  .stamp-copy > span { margin-top: .55rem; color: #f7d876; font-size: .66rem; font-weight: 700; }
  .stamp-spot[aria-pressed="true"] {
    border-color: rgb(247 216 118 / .48);
    background: rgb(244 201 94 / .12);
  }
  .stamp-spot[aria-pressed="true"] .stamp-seal {
    border: 3px double #f7d876;
    background: rgb(232 125 98 / .9);
    color: white;
    box-shadow: 0 7px 20px rgb(0 0 0 / .2);
    transform: rotate(5deg) scale(1.03);
  }
  .stamp-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    margin-top: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / .12);
    padding-top: 1.15rem;
  }
  .stamp-card-footer strong { color: #fff9e8; font-size: .9rem; }
  .stamp-card-footer p { margin-top: .25rem; color: rgb(255 255 255 / .48); font-size: .72rem; line-height: 1.5; }
  .stamp-footer-actions { display: flex; flex: 0 0 auto; align-items: center; gap: .7rem; }
  .stamp-reward-link {
    border-radius: 999px;
    background: #f4c95e;
    padding: .75rem 1rem;
    color: #294f47;
    font-size: .78rem;
    font-weight: 700;
  }
  .stamp-reset {
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / .16);
    padding: .7rem .9rem;
    color: rgb(255 255 255 / .58);
    font-size: .7rem;
    font-weight: 700;
  }
  [hidden] { display: none !important; }
  @media (max-width: 799px) {
    .stamp-grid {
      grid-auto-columns: minmax(9.5rem, 44vw);
      grid-auto-flow: column;
      grid-template-columns: none;
      overflow-x: auto;
      padding-bottom: .5rem;
      scroll-snap-type: x proximity;
    }
    .stamp-spot { scroll-snap-align: start; }
  }
  @media (max-width: 639px) {
    .stamp-card { border-radius: 1.55rem; padding: 1.1rem; }
    .stamp-card-heading { align-items: stretch; flex-direction: column; gap: 1rem; }
    .stamp-count { display: flex; align-items: center; justify-content: space-between; padding: .75rem 1rem; text-align: left; }
    .stamp-count strong { font-size: 1.65rem; }
    .stamp-count > span { margin-top: 0; }
    .stamp-card-footer { align-items: stretch; flex-direction: column; }
    .stamp-footer-actions { justify-content: space-between; }
  }
</style>
