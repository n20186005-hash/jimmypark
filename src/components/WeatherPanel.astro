---
import WeatherIcon from './WeatherIcon.astro';
import {
  fetchWeather,
  buildWeatherUrl,
  describeWeather,
  formatDay,
  todayString,
  currentNormals,
  weatherProvider,
  weatherEnvironment,
  officialAlertSource,
  beaufortFromKmh,
  FORECAST_DAYS,
  type DailyWeather,
} from '../data/weather';
import { buildWeatherAdvice } from '../data/weatherAdvice';
import { site } from '../data/site';

const snapshot = await fetchWeather();
const today = todayString();
const daily = snapshot.daily.slice(0, FORECAST_DAYS);

const currentWeather = snapshot.current;
const currentInfo = describeWeather(currentWeather?.weatherCode ?? 3);
const todayItem: DailyWeather | null =
  daily.find((item) => item.date === today) ?? daily[0] ?? null;

const advice = buildWeatherAdvice({
  current: currentWeather,
  today: todayItem,
  environment: weatherEnvironment,
});

const normals = currentNormals();
const updatedLabel = snapshot.updatedAt
  ? snapshot.updatedAt.replace('T', ' ').slice(0, 16)
  : null;

const formatTemp = (value: number | null): string =>
  value === null ? '—' : `${Math.round(value)}°`;

const currentUv = currentWeather?.uvIndex ?? todayItem?.uvIndexMax ?? null;
const currentWindForce = beaufortFromKmh(
  Math.max(currentWeather?.windGusts ?? 0, currentWeather?.windSpeed ?? 0),
);
const dayWindForce = (item: DailyWeather): number =>
  beaufortFromKmh(Math.max(item.windGustsMax ?? 0, item.windSpeedMax ?? 0));

const adviceGroups = [
  {
    key: 'outfit',
    label: '出行穿搭',
    hint: '怎麼穿',
    items: advice.outfit,
    chipClass: 'bg-forest/10 text-forest',
    dotClass: 'bg-forest',
  },
  {
    key: 'plan',
    label: '遊玩安排',
    hint: '怎麼走',
    items: advice.plan,
    chipClass: 'bg-coral/12 text-coral',
    dotClass: 'bg-coral',
  },
  {
    key: 'items',
    label: '隨身物品',
    hint: '帶什麼',
    items: advice.items,
    chipClass: 'bg-sun/25 text-[#8a6212]',
    dotClass: 'bg-[#c79a2a]',
  },
] as const;
---

<section
  id="weather"
  class="storybook-section storybook-section-sky section-pad border-y border-forest/10 bg-paper"
  data-weather-root
  data-api={buildWeatherUrl()}
>
  <div class="container-shell">
    <div class="mx-auto max-w-3xl text-center">
      <p class="section-kicker justify-center">即時天氣與 7 日預報</p>
      <h2 class="mt-5 text-4xl font-bold tracking-tight text-forest-dark sm:text-5xl">
        出門前先看這裡：幾米公園現在的天氣與建議
      </h2>
      <p class="mt-5 text-lg leading-8 text-ink/65">
        幾米公園幾乎全程在戶外，天氣直接決定這趟散步值不值得。以下除了即時觀測與 7 日預報，還會依天氣直接告訴你「該怎麼穿、怎麼走、帶什麼」。
      </p>
    </div>

    <div
      data-advice-risk
      hidden={!advice.hasRisk}
      class="mt-10 rounded-[1.7rem] border-2 border-coral/45 bg-coral/10 p-6 sm:p-7"
    >
      <p class="flex items-center gap-2 text-sm font-bold tracking-[0.14em] text-[#8f3a2b]">
        <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true">
          <path d="M12 3 2.5 20h19L12 3Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
          <path d="M12 9v5m0 3v.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        風險提醒
      </p>
      <ul class="mt-4 space-y-2 text-sm leading-7 text-[#7a3524]" data-advice-risks>
        {
          advice.risks.map((line) => (
            <li class="flex gap-2">
              <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-[#c2543f]" aria-hidden="true" />
              <span>{line}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <p
      data-advice-risk-empty
      hidden={advice.hasRisk}
      class="mt-10 rounded-2xl border border-forest/20 bg-white/70 px-5 py-4 text-center text-sm leading-6 text-ink/65"
    >
      目前沒有特殊氣象風險，可依下方建議正常安排行程。
    </p>

    <div class="mt-8 grid gap-6 lg:grid-cols-[.85fr_1.15fr]">
      <article class="card-soft flex flex-col p-7 sm:p-9">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-xs font-bold tracking-[0.18em] text-coral">現在</p>
            <p class="mt-3 flex items-baseline gap-1 text-forest-dark">
              <span class="text-6xl font-bold leading-none" data-weather-temp>
                {formatTemp(currentWeather?.temperature ?? null)}
              </span>
            </p>
            <p class="mt-3 text-lg font-bold text-forest-dark" data-weather-desc>
              {currentInfo.text}
            </p>
            <p class="mt-2 text-sm leading-6 text-ink/60" data-weather-headline>
              {snapshot.fallback ? `${normals.label}常年平均 ${normals.low}–${normals.high}°` : advice.headline}
            </p>
          </div>
          <span class="grid size-16 shrink-0 place-items-center rounded-2xl bg-sun/25 text-[#8a6212]" data-weather-icon>
            <WeatherIcon kind={currentInfo.kind} class="size-9" />
          </span>
        </div>

        <dl class="mt-7 grid grid-cols-2 gap-4 text-sm">
          <div class="rounded-2xl bg-white/70 p-4">
            <dt class="text-ink/60">體感溫度</dt>
            <dd class="mt-1 text-lg font-bold text-forest-dark" data-weather-feels>
              {formatTemp(currentWeather?.apparentTemperature ?? null)}
            </dd>
          </div>
          <div class="rounded-2xl bg-white/70 p-4">
            <dt class="text-ink/60">相對濕度</dt>
            <dd class="mt-1 text-lg font-bold text-forest-dark" data-weather-humidity>
              {currentWeather ? `${Math.round(currentWeather.humidity)}%` : '—'}
            </dd>
          </div>
          <div class="rounded-2xl bg-white/70 p-4">
            <dt class="text-ink/60">今日降雨機率</dt>
            <dd class="mt-1 text-lg font-bold text-forest-dark" data-weather-pop>
              {todayItem?.precipitationProbability !== null && todayItem?.precipitationProbability !== undefined
                ? `${todayItem.precipitationProbability}%`
                : '—'}
            </dd>
          </div>
          <div class="rounded-2xl bg-white/70 p-4">
            <dt class="text-ink/60">目前降雨</dt>
            <dd class="mt-1 text-lg font-bold text-forest-dark" data-weather-rain>
              {currentWeather ? `${currentWeather.precipitation.toFixed(1)} mm` : '—'}
            </dd>
          </div>
          <div class="rounded-2xl bg-white/70 p-4">
            <dt class="text-ink/60">風速</dt>
            <dd class="mt-1 text-lg font-bold text-forest-dark" data-weather-wind>
              {currentWeather ? `${Math.round(currentWeather.windSpeed)} km/h` : '—'}
            </dd>
            <p class="mt-0.5 text-xs text-ink/55" data-weather-wind-label>
              {`${currentWindForce} 級・${advice.windLabel}`}
            </p>
          </div>
          <div class="rounded-2xl bg-white/70 p-4">
            <dt class="text-ink/60">紫外線</dt>
            <dd class="mt-1 text-lg font-bold text-forest-dark" data-weather-uv>
              {currentUv === null ? '—' : `${Math.round(currentUv)}${currentUv >= 5 ? '（偏強）' : ''}`}
            </dd>
          </div>
        </dl>
      </article>

      <div class="card-soft p-7 sm:p-9">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <p class="text-xs font-bold tracking-[0.18em] text-forest">未來 7 日</p>
          <p class="text-xs text-ink/55">溫度為每日最高／最低，降雨為當日機率</p>
        </div>

        <ol class="mt-5 grid gap-3" data-weather-days>
          {
            daily.map((item, index) => {
              const info = describeWeather(item.weatherCode);
              const day = formatDay(item.date, today);
              const wf = dayWindForce(item);
              return (
                <li
                  class="grid grid-cols-[3.5rem_2.5rem_1fr_auto] items-center gap-3 rounded-2xl bg-white/70 p-4 sm:grid-cols-[4.5rem_2.5rem_1fr_7rem]"
                  data-day={item.date}
                >
                  <span class="text-sm font-bold text-forest-dark">
                    <span data-field="label">{index === 0 ? '今天' : day.weekday}</span>
                    <span class="mt-0.5 block text-xs font-normal text-ink/55" data-field="date">
                      {day.monthDay}
                    </span>
                  </span>
                  <span class="grid size-10 place-items-center rounded-xl bg-sky text-forest" data-field="icon">
                    <WeatherIcon kind={info.kind} class="size-6" />
                  </span>
                  <span class="min-w-0">
                    <span class="block text-sm font-bold text-forest-dark" data-field="desc">
                      {info.text}
                    </span>
                    <span class="mt-0.5 block text-xs leading-5 text-ink/60" data-field="pop">
                      {`降雨機率 ${item.precipitationProbability ?? '—'}%`}
                      {item.uvIndexMax !== null && ` ・ 紫外線 ${Math.round(item.uvIndexMax)}`}
                      {wf >= 5 && ` ・ 風力 ${wf} 級`}
                    </span>
                  </span>
                  <span class="text-right text-sm font-bold text-forest-dark" data-field="temp">
                    {formatTemp(item.max)} / {formatTemp(item.min)}
                  </span>
                </li>
              );
            })
          }
        </ol>

        {
          snapshot.fallback && (
            <p class="mt-5 rounded-2xl bg-white/70 p-4 text-sm leading-6 text-ink/65">
              目前無法取得即時預報，以上為長期氣候平均的概略參考。宜蘭降雨日數偏多，建議仍以雨具為標準配備。
            </p>
          )
        }
      </div>
    </div>

    <div class="mt-6 grid gap-5 lg:grid-cols-3">
      {
        adviceGroups.map((group) => (
          <article class="card-soft flex flex-col p-6 sm:p-7">
            <div class="flex items-center justify-between gap-3">
              <p class:list={['inline-flex items-center gap-2 rounded-full px-3 py-1.5 text-xs font-bold tracking-[0.12em]', group.chipClass]}>
                {group.label}
              </p>
              <span class="text-xs text-ink/50">{group.hint}</span>
            </div>
            <ul class="mt-5 space-y-3 text-sm leading-7 text-ink/70" data-advice={group.key}>
              {group.items.map((line) => (
                <li class="flex gap-2.5">
                  <span class:list={['mt-2.5 size-1.5 shrink-0 rounded-full', group.dotClass]} aria-hidden="true" />
                  <span>{line}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <p class="mt-6 text-center text-xs leading-6 text-ink/60">
      氣象資料：{weatherProvider.name}（宜蘭市・北緯 {site.latitude}／東經 {site.longitude}）{updatedLabel ? `・更新於 ${updatedLabel}` : ''}
      <a
        class="ml-1 underline decoration-forest/25 underline-offset-4 hover:text-forest"
        href={weatherProvider.url}
        target="_blank"
        rel="noopener noreferrer"
      >
        查看氣象資料來源
      </a>
      ・官方警特報請以
      <a
        class="underline decoration-forest/25 underline-offset-4 hover:text-forest"
        href={officialAlertSource.url}
        target="_blank"
        rel="noopener noreferrer"
      >
        {officialAlertSource.name}
      </a>
      公告為準。
    </p>
  </div>
</section>

<div class="hidden" aria-hidden="true" data-weather-icons>
  {
    (['clear', 'partly', 'cloud', 'fog', 'drizzle', 'rain', 'snow', 'storm'] as const).map((kind) => (
      <span data-kind={kind}>
        <WeatherIcon kind={kind} class="size-6" />
      </span>
    ))
  }
</div>

<script>
  import {
    buildWeatherUrl,
    describeWeather,
    formatDay,
    todayString,
    snapshotFromPayload,
    beaufortFromKmh,
    weatherEnvironment,
    FORECAST_DAYS,
    type DailyWeather,
  } from '../data/weather';
  import { buildWeatherAdvice } from '../data/weatherAdvice';

  const root = document.querySelector<HTMLElement>('[data-weather-root]');
  if (root) {
    const apiUrl = root.dataset.api ?? buildWeatherUrl();
    const today = todayString();
    const iconSource = document.querySelector<HTMLElement>('[data-weather-icons]');

    const cloneIcon = (kind: string): SVGElement | null => {
      const source = iconSource?.querySelector<HTMLElement>(`[data-kind="${kind}"] svg`);
      return source ? (source.cloneNode(true) as SVGElement) : null;
    };

    const setText = (selector: string, value: string) => {
      const node = root.querySelector<HTMLElement>(selector);
      if (node) node.textContent = value;
    };

    const round = (value: number | null): string =>
      value === null || Number.isNaN(value) ? '—' : String(Math.round(value));

    const renderIcon = (host: HTMLElement | null, kind: string, size: string) => {
      if (!host) return;
      const icon = cloneIcon(kind);
      if (!icon) return;
      icon.setAttribute('class', size);
      host.replaceChildren(icon);
    };

    const renderList = (key: string, items: string[]) => {
      const list = root.querySelector<HTMLUListElement>(`[data-advice="${key}"]`);
      if (!list) return;
      const nodes = items.map((text) => {
        const li = document.createElement('li');
        li.className = 'flex gap-2.5';
        const dot = document.createElement('span');
        dot.className = 'mt-2.5 size-1.5 shrink-0 rounded-full bg-current opacity-60';
        dot.setAttribute('aria-hidden', 'true');
        const span = document.createElement('span');
        span.textContent = text;
        li.append(dot, span);
        return li;
      });
      list.replaceChildren(...nodes);
    };

    const render = (payload: unknown) => {
      const snapshot = snapshotFromPayload(payload);
      const current = snapshot.current;

      if (current) {
        const info = describeWeather(current.weatherCode);
        setText('[data-weather-temp]', `${round(current.temperature)}°`);
        setText('[data-weather-desc]', info.text);
        setText('[data-weather-feels]', `${round(current.apparentTemperature)}°`);
        setText('[data-weather-humidity]', `${round(current.humidity)}%`);
        setText('[data-weather-rain]', `${current.precipitation.toFixed(1)} mm`);
        setText('[data-weather-wind]', `${round(current.windSpeed)} km/h`);
        renderIcon(root.querySelector<HTMLElement>('[data-weather-icon]'), info.kind, 'size-9');
      }

      const days: DailyWeather[] = snapshot.daily.slice(0, FORECAST_DAYS);
      const todayItem = days.find((item) => item.date === today) ?? days[0] ?? null;

      setText(
        '[data-weather-pop]',
        todayItem?.precipitationProbability !== null && todayItem?.precipitationProbability !== undefined
          ? `${todayItem.precipitationProbability}%`
          : '—',
      );

      const advice = buildWeatherAdvice({
        current,
        today: todayItem,
        environment: weatherEnvironment,
      });

      setText('[data-weather-headline]', advice.headline);
      setText(
        '[data-weather-wind-label]',
        `${beaufortFromKmh(Math.max(current?.windGusts ?? 0, current?.windSpeed ?? 0))} 級・${advice.windLabel}`,
      );

      const uv = current?.uvIndex ?? todayItem?.uvIndexMax ?? null;
      setText('[data-weather-uv]', uv === null ? '—' : `${Math.round(uv)}${uv >= 5 ? '（偏強）' : ''}`);

      const riskBox = root.querySelector<HTMLElement>('[data-advice-risk]');
      const riskList = root.querySelector<HTMLUListElement>('[data-advice-risks]');
      if (riskBox) riskBox.hidden = advice.risks.length === 0;
      if (riskList) {
        riskList.replaceChildren(
          ...advice.risks.map((text) => {
            const li = document.createElement('li');
            li.className = 'flex gap-2';
            const dot = document.createElement('span');
            dot.className = 'mt-2.5 size-1.5 shrink-0 rounded-full bg-[#c2543f]';
            dot.setAttribute('aria-hidden', 'true');
            const span = document.createElement('span');
            span.textContent = text;
            li.append(dot, span);
            return li;
          }),
        );
      }
      const riskEmpty = root.querySelector<HTMLElement>('[data-advice-risk-empty]');
      if (riskEmpty) riskEmpty.hidden = advice.risks.length > 0;

      renderList('outfit', advice.outfit);
      renderList('plan', advice.plan);
      renderList('items', advice.items);

      days.forEach((item, index) => {
        const row = root.querySelector<HTMLElement>(`[data-day="${item.date}"]`);
        if (!row) return;
        const info = describeWeather(item.weatherCode);
        const day = formatDay(item.date, today);
        const field = (name: string) => row.querySelector<HTMLElement>(`[data-field="${name}"]`);

        const label = field('label');
        if (label) label.textContent = index === 0 ? '今天' : day.weekday;
        const date = field('date');
        if (date) date.textContent = day.monthDay;
        const desc = field('desc');
        if (desc) desc.textContent = info.text;
        const pop = field('pop');
        if (pop) {
          const uvText = item.uvIndexMax === null ? '' : ` ・ 紫外線 ${Math.round(item.uvIndexMax)}`;
          const wf = beaufortFromKmh(Math.max(item.windGustsMax ?? 0, item.windSpeedMax ?? 0));
          const windText = wf >= 5 ? ` ・ 風力 ${wf} 級` : '';
          pop.textContent = `降雨機率 ${item.precipitationProbability ?? '—'}%${uvText}${windText}`;
        }
        const temp = field('temp');
        if (temp) temp.textContent = `${round(item.max)}° / ${round(item.min)}°`;

        renderIcon(field('icon'), info.kind, 'size-6');
      });
    };

    fetch(apiUrl)
      .then((response) => (response.ok ? response.json() : Promise.reject(new Error('failed'))))
      .then(render)
      .catch(() => {
        /* 取不到最新資料時保留首次算好的內容，不打斷閱讀 */
      });
  }
</script>
