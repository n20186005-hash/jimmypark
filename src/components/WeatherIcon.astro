---
import type { WeatherKind } from '../data/weather';

interface Props {
  kind: WeatherKind;
  class?: string;
}

const { kind, class: className = 'size-8' } = Astro.props;
---

<svg viewBox="0 0 32 32" class={className} aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
  {
    kind === 'clear' && (
      <>
        <circle cx="16" cy="16" r="6" />
        <path d="M16 4v3M16 25v3M4 16h3M25 16h3M7.5 7.5l2.1 2.1M22.4 22.4l2.1 2.1M24.5 7.5l-2.1 2.1M9.6 22.4l-2.1 2.1" />
      </>
    )
  }
  {
    kind === 'partly' && (
      <>
        <circle cx="11" cy="11" r="5" />
        <path d="M11 2.5v2M2.5 11h2M5 5l1.4 1.4M17 5l-1.4 1.4" />
        <path d="M12 25h11a4 4 0 0 0 .4-8A5.5 5.5 0 0 0 12.6 17 4 4 0 0 0 12 25Z" />
      </>
    )
  }
  {
    (kind === 'cloud' || kind === 'fog') && (
      <>
        <path d="M9 24h14a5 5 0 0 0 .5-10A6.5 6.5 0 0 0 11 13.6 5.2 5.2 0 0 0 9 24Z" />
        {kind === 'fog' && <path d="M7 28h18M9.5 31h13" />}
      </>
    )
  }
  {
    (kind === 'drizzle' || kind === 'rain') && (
      <>
        <path d="M9 21h14a5 5 0 0 0 .5-10A6.5 6.5 0 0 0 11 10.6 5.2 5.2 0 0 0 9 21Z" />
        {kind === 'drizzle' ? (
          <path d="M13 25v1.5M19 25v1.5" />
        ) : (
          <path d="M12 24.5 11 28M18 24.5 17 28M23.5 24.5 22.5 28" />
        )}
      </>
    )
  }
  {
    kind === 'snow' && (
      <>
        <path d="M9 21h14a5 5 0 0 0 .5-10A6.5 6.5 0 0 0 11 10.6 5.2 5.2 0 0 0 9 21Z" />
        <path d="M13 26.5v4M11 28.5h4M21 26.5v4M19 28.5h4" />
      </>
    )
  }
  {
    kind === 'storm' && (
      <>
        <path d="M9 21h14a5 5 0 0 0 .5-10A6.5 6.5 0 0 0 11 10.6 5.2 5.2 0 0 0 9 21Z" />
        <path d="M18 23.5 14 29h4l-2 4" />
      </>
    )
  }
</svg>
