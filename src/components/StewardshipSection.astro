---
import { stewardshipIntro, stewardshipItems } from '../data/stewardship';
---

<section
  id="stewardship"
  class="storybook-section storybook-section-peach section-pad bg-paper"
  aria-labelledby="stewardship-title"
>
  <div class="container-shell">
    <div class="max-w-3xl">
      <p class="section-kicker">科普與訪客責任</p>
      <h2 id="stewardship-title" class="mt-5 text-4xl font-bold tracking-tight text-forest-dark sm:text-5xl">
        為什麼要這樣做：讓公共藝術與舊宿舍繼續被使用
      </h2>
      <p class="mt-6 text-lg leading-8 text-ink/70">{stewardshipIntro}</p>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        stewardshipItems.map((item, index) => (
          <article class="card-soft flex h-full flex-col p-6 sm:p-7">
            <div class="flex items-center gap-3">
              <span class="grid size-9 shrink-0 place-items-center rounded-full bg-forest text-sm font-bold text-white">
                {index + 1}
              </span>
              <h3 class="text-lg font-bold leading-7 text-forest-dark">{item.title}</h3>
            </div>
            <p class="mt-4 rounded-2xl bg-white/70 p-4 text-sm leading-6 text-ink/65">
              <strong class="text-forest-dark">為什麼：</strong>{item.why}
            </p>
            <ul class="mt-5 space-y-2 text-sm leading-6 text-ink/68">
              {item.do.map((line) => (
                <li class="flex gap-2">
                  <span class="mt-2 size-1.5 shrink-0 rounded-full bg-moss" aria-hidden="true"></span>
                  <span>{line}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
