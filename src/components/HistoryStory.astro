---
import {
  historyIntro,
  timeline,
  storyDecoding,
  authorProfile,
  architecture,
  folklore,
} from '../data/history';
---

<section
  id="history"
  class="storybook-section storybook-section-sky section-pad paper-grid border-y border-forest/10 bg-paper"
  aria-labelledby="history-title"
>
  <div class="container-shell">
    <div class="max-w-3xl">
      <p class="section-kicker">景點故事與歷史</p>
      <h2 id="history-title" class="mt-5 text-4xl font-bold tracking-tight text-forest-dark sm:text-5xl">
        幾米主題廣場的歷史與意義：舊鐵路宿舍如何變成一座繪本廣場
      </h2>
      <p class="mt-6 text-lg leading-8 text-ink/70">{historyIntro}</p>
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-[1.05fr_.95fr] lg:gap-16">
      <div>
        <h3 class="text-2xl font-bold text-forest-dark">時間軸：從再生案到幾米廊帶</h3>
        <ol class="mt-6 space-y-0">
          {
            timeline.map((entry, index) => (
              <li class="relative pb-8 pl-8 last:pb-0">
                <span class="absolute left-0 top-1.5 grid size-4 place-items-center rounded-full bg-forest" aria-hidden="true">
                  <span class="size-1.5 rounded-full bg-white"></span>
                </span>
                {index !== timeline.length - 1 && (
                  <span class="absolute left-[0.45rem] top-6 h-[calc(100%-1rem)] w-px bg-forest/20" aria-hidden="true"></span>
                )}
                <p class="text-sm font-bold tracking-[0.14em] text-coral">{entry.year}</p>
                <p class="mt-1 text-lg font-bold text-forest-dark">{entry.title}</p>
                <p class="mt-2 leading-7 text-ink/68">{entry.text}</p>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="space-y-6">
        <article class="card-soft p-7">
          <p class="text-xs font-bold tracking-[0.18em] text-forest/70">關於創作者</p>
          <h3 class="mt-3 text-2xl font-bold text-forest-dark">{authorProfile.name}</h3>
          <p class="mt-2 text-sm font-bold text-forest/80">{authorProfile.meta}</p>
          <div class="mt-5 space-y-4 text-sm leading-7 text-ink/70">
            {authorProfile.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </article>

        <article class="card-soft p-7">
          <p class="text-xs font-bold tracking-[0.18em] text-forest/70">空間與建築</p>
          <div class="mt-5 space-y-5">
            {
              architecture.map((item) => (
                <div>
                  <h4 class="font-bold text-forest-dark">{item.title}</h4>
                  <p class="mt-2 text-sm leading-7 text-ink/70">{item.text}</p>
                </div>
              ))
            }
          </div>
        </article>
      </div>
    </div>

    <div class="mt-16">
      <div class="max-w-3xl">
        <p class="section-kicker">繪本場景解碼</p>
        <h3 class="mt-4 text-3xl font-bold tracking-tight text-forest-dark sm:text-4xl">
          你在現場看到的，分別來自哪一本繪本？
        </h3>
        <p class="mt-4 text-lg leading-8 text-ink/65">
          知道作品的出處與設計意圖，照片就不只是「跟人偶合照」，而是一段可以說給同行者聽的故事。
        </p>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {
          storyDecoding.map((item) => (
            <article class="card-soft flex h-full flex-col p-6">
              <p class="text-xs font-bold tracking-[0.16em] text-coral">{item.work}</p>
              <h4 class="mt-3 text-xl font-bold leading-7 text-forest-dark">{item.title}</h4>
              <p class="mt-3 flex-1 text-sm leading-7 text-ink/68">{item.text}</p>
              <p class="mt-4 border-t border-forest/10 pt-4 text-xs font-bold text-forest/75">
                現場位置：{item.where}
              </p>
            </article>
          ))
        }
      </div>
    </div>

    <div class="storybook-map-card mt-16 bg-[#fffdf7] p-7 sm:p-10">
      <p class="text-xs font-bold tracking-[0.18em] text-forest/70">在地故事</p>
      <h3 class="mt-3 text-3xl font-bold text-forest-dark">{folklore.title}</h3>
      <div class="mt-5 space-y-4 text-lg leading-8 text-ink/70">
        {folklore.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <p class="mt-6 text-sm leading-6 text-ink/55">{folklore.note}</p>
    </div>

    <p class="mt-6 text-xs leading-6 text-ink/60">
      以上背景整理自幾米官方網站作品介紹、文化部國家文化記憶庫、宜蘭縣政府觀光旅遊網與當時的新聞報導；設施與經營現況可能變動，請以現場公告為準。
    </p>
  </div>
</section>
